with "config/espidf_http_server_config.gpr";

with "espidf.gpr";

library project ESPIDF_HTTP_Server is

   for Languages use ("Ada", "C");
   for Library_Name use "adaespidf_http_server";
   for Library_Dir use ".libs/" & ESPIDF.Crate_Library_Dir;
   for Object_Dir use ".objs/" & ESPIDF.Crate_Object_Dir;
   for Source_Dirs use ("source");

   package Compiler renames ESPIDF.Compiler;

end ESPIDF_HTTP_Server;
